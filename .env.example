# Copia este archivo a .env y rellena los valores reales antes de ejecutar docker compose
# cp .env.example .env

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_USERNAME=lastmile
DB_PASSWORD=lastmile_pass
DB_NAME=lastmile_db

# ── Autenticación ─────────────────────────────────────────────────────────────
JWT_SECRET=reemplaza_con_un_secreto_seguro_de_32_chars_minimo
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# ── Firma de requests ─────────────────────────────────────────────────────────
REQUEST_SIGNING_SECRET=reemplaza_con_secreto_firma

# ── CORS (orígenes permitidos, separados por coma) ────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
